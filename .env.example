# Base URL для backend. В dev-режиме используется только в vite.config.ts (proxy).
# В коде клиента всегда обращаемся через относительные пути /api/* — proxy в Vite
# и nginx в проде разруливают.
VITE_API_BASE_URL=http://2.27.86.52:3500

# Версия приложения — попадает в UI и в логи sync. По умолчанию из package.json.
# VITE_APP_VERSION=

# Mock-режим — window.fetch перехватывается локальными хендлерами.
# Используется для разработки без живого бэка и для демо.
# VITE_USE_MOCKS=true

# Прод-конфигурация. Фронт хостится на GitHub Pages под
# https://<owner>.github.io/<repo>/, бэк — на сервере 2.27.86.52 через
# Cloudflare-туннель.
#
# VITE_BASE_PATH — префикс репозитория. Если фронт в org dinskstroi1217-hub
# в репо kip-frontend, то путь /kip-frontend/. Если положить в корень
# (через CNAME / отдельный домен) — поменять на /.
VITE_BASE_PATH=/kip-frontend/

# Базовый URL живого бэка — корп-сервер 185.196.118.7, контейнер
# kip-driver-app, через nginx-proxy путь /driver-api/.
# Туннель — Serveo SSH (вместо CF, который сейчас банит quick-tunnels с этого IP).
# Watchdog перезапускает туннель если упадёт. Hash в URL завязан на IP сервера,
# но может меняться при ре-инициализации — проверь актуальность через:
#   ssh kip-corp 'cat ~/serveo.url 2>/dev/null || journalctl --user -u serveo* -n 20'
VITE_API_BASE_URL=https://fb66f72c83170f11-185-196-118-7.serveousercontent.com/driver-api

# Моки в проде выключены явно. Если когда-нибудь понадобится демо-сборка с
# моками — собирать с `VITE_USE_MOCKS=true npm run build`.
VITE_USE_MOCKS=false
